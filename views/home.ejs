<%- include('./partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

  <%- include('./partials/navbar') %>


  <div class="relative overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute -top-24 -right-24 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"></div>


    <!-- HERO -->

    <section class="relative max-w-7xl mx-auto px-6 pt-16 pb-20">

      <div class="flex flex-wrap items-center gap-3">

        <span class="inline-block px-4 py-2 rounded-full
                     bg-white/10 border border-white/10
                     text-indigo-300 text-sm font-semibold">
          ✦ VONEXA DIGITAL SOLUTIONS
        </span>

        <span class="inline-flex items-center gap-2 px-4 py-2 rounded-full
                     bg-white/5 border border-white/10
                     text-slate-300 text-sm font-semibold">
          🛡️ Trusted by Local Businesses
        </span>

      </div>

      <h1 class="mt-6 text-4xl md:text-6xl font-black tracking-tight leading-tight max-w-3xl">
        Digital solutions for
        <span class="text-transparent bg-clip-text
                     bg-gradient-to-r from-indigo-400 to-purple-400">
          every business.
        </span>
      </h1>

      <p class="mt-5 max-w-2xl text-slate-400 text-lg leading-relaxed">
        Websites, digital tools, marketing & growth — all under one
        roof. We help local businesses get online, get discovered,
        and get more customers.
      </p>

      <div class="mt-8 flex flex-wrap gap-4">

        <a href="/homes"
           class="inline-flex items-center gap-2
                  px-7 py-3.5 rounded-xl
                  bg-gradient-to-r from-indigo-600 to-purple-600
                  text-white font-bold
                  shadow-lg shadow-indigo-900/30
                  hover:from-indigo-500 hover:to-purple-500
                  hover:-translate-y-0.5
                  transition">
          View Packages →
        </a>

<a href="/demos"
   class="group relative inline-flex items-center gap-3
          px-7 py-3.5 rounded-xl
          bg-slate-900
          border border-indigo-500/40
          text-white font-bold
          overflow-hidden
          shadow-lg shadow-indigo-500/20
          hover:border-purple-400
          hover:shadow-purple-500/30
          hover:-translate-y-1
          transition-all duration-300">

  <span class="absolute inset-0
               bg-gradient-to-r from-indigo-600/20 to-purple-600/20
               opacity-0 group-hover:opacity-100
               transition-opacity duration-300"></span>

  <span class="relative">View Demos</span>

  <span class="relative text-xl
               group-hover:translate-x-1
               transition-transform duration-300">
    ↗
  </span>

</a>
        <a href="/enquiry"
           class="inline-flex items-center gap-2
                  px-7 py-3.5 rounded-xl
                  border border-white/10 bg-white/5
                  text-white font-bold
                  hover:bg-white/10
                  transition">
          Get Started
        </a>

      </div>


      <!-- Trust strip -->

      <div class="mt-14 grid grid-cols-2 md:grid-cols-4 gap-4">

        <div class="flex items-center gap-3
                    bg-white/5 border border-white/10
                    rounded-2xl px-4 py-3">
          <span class="text-xl">🛡️</span>
          <div>
            <p class="text-sm font-semibold text-slate-200">Professional Quality</p>
            <p class="text-xs text-slate-500">Top-notch designs & content</p>
          </div>
        </div>

        <div class="flex items-center gap-3
                    bg-white/5 border border-white/10
                    rounded-2xl px-4 py-3">
          <span class="text-xl">⏱️</span>
          <div>
            <p class="text-sm font-semibold text-slate-200">On-Time Delivery</p>
            <p class="text-xs text-slate-500">We respect your time</p>
          </div>
        </div>

        <div class="flex items-center gap-3
                    bg-white/5 border border-white/10
                    rounded-2xl px-4 py-3">
          <span class="text-xl">🎧</span>
          <div>
            <p class="text-sm font-semibold text-slate-200">Dedicated Support</p>
            <p class="text-xs text-slate-500">Always here to help</p>
          </div>
        </div>

        <div class="flex items-center gap-3
                    bg-white/5 border border-white/10
                    rounded-2xl px-4 py-3">
          <span class="text-xl">🔒</span>
          <div>
            <p class="text-sm font-semibold text-slate-200">Secure & Reliable</p>
            <p class="text-xs text-slate-500">Safe. Fast. Trusted.</p>
          </div>
        </div>

      </div>

    </section>


    <!-- WHAT WE OFFER -->

    <section class="relative max-w-7xl mx-auto px-6 py-16">

      <p class="text-indigo-400 text-sm font-semibold uppercase tracking-widest text-center">
        What We Offer
      </p>

      <h2 class="text-3xl md:text-4xl font-bold mt-2 text-center">
        Everything your business needs online
      </h2>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mt-12">

        <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-7
                    hover:border-indigo-500/40 hover:-translate-y-1
                    transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-indigo-500/10
                      flex items-center justify-center text-2xl mb-5">
            🌐
          </div>
          <h3 class="text-lg font-bold">Websites</h3>
          <p class="text-sm text-slate-500 mt-2 leading-relaxed">
            Landing pages and full business websites, built fast
            and designed to convert visitors into customers.
          </p>
        </div>

        <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-7
                    hover:border-indigo-500/40 hover:-translate-y-1
                    transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-purple-500/10
                      flex items-center justify-center text-2xl mb-5">
            🧰
          </div>
          <h3 class="text-lg font-bold">Digital Tools</h3>
          <p class="text-sm text-slate-500 mt-2 leading-relaxed">
            NFC business cards, QR menus, Google Business setup —
            practical tools that make you easy to find and contact.
          </p>
        </div>

        <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-7
                    hover:border-indigo-500/40 hover:-translate-y-1
                    transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-emerald-500/10
                      flex items-center justify-center text-2xl mb-5">
            📣
          </div>
          <h3 class="text-lg font-bold">Marketing</h3>
          <p class="text-sm text-slate-500 mt-2 leading-relaxed">
            Social media management, content creation, and
            professional video — so your brand stays visible.
          </p>
        </div>

        <div class="bg-slate-900/80 border border-white/10 rounded-3xl p-7
                    hover:border-indigo-500/40 hover:-translate-y-1
                    transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10
                      flex items-center justify-center text-2xl mb-5">
            📈
          </div>
          <h3 class="text-lg font-bold">Growth</h3>
          <p class="text-sm text-slate-500 mt-2 leading-relaxed">
            SEO, analytics, and monthly strategy sessions to keep
            your business growing, month after month.
          </p>
        </div>

      </div>

    </section>


    <!-- FEATURED PACKAGES -->

    <section class="relative max-w-7xl mx-auto px-6 py-16">

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">

        <div>
          <p class="text-indigo-400 text-sm font-semibold uppercase tracking-widest">
            Packages
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mt-2">
            Start with the right plan
          </h2>
        </div>

        <a href="/pricing"
           class="inline-flex items-center gap-2
                  text-indigo-400 font-semibold
                  hover:text-indigo-300 transition w-fit">
          View all packages →
        </a>

      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

        <div class="bg-slate-900/80 border border-blue-500/20
                    rounded-3xl p-6 flex flex-col
                    hover:border-blue-400/40 transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-blue-500/10
                      flex items-center justify-center text-2xl mb-4">
            🚀
          </div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Vonexa</p>
          <h3 class="text-xl font-black mt-0.5">Essential</h3>
          <p class="text-sm text-slate-500 mt-1">Perfect start for your business</p>
          <p class="mt-5 text-3xl font-black text-white">₹3,499</p>
          <p class="text-xs text-slate-500 font-semibold">ONE-TIME</p>
          <a href="/enquiry?package=<%= encodeURIComponent('Vonexa Essential') %>"
             class="mt-6 block text-center py-3 rounded-xl font-bold text-sm
                    border border-blue-500/40 text-blue-300
                    hover:bg-blue-500/10 transition">
            GET STARTED
          </a>
        </div>

        <div class="relative bg-slate-900/80 border border-purple-500/40
                    rounded-3xl p-6 flex flex-col md:-translate-y-2
                    shadow-xl shadow-purple-900/20
                    hover:border-purple-400/60 transition-all duration-300">
          <span class="absolute -top-3 left-1/2 -translate-x-1/2
                       px-4 py-1 rounded-full
                       bg-gradient-to-r from-indigo-600 to-purple-600
                       text-xs font-bold whitespace-nowrap">
            MOST POPULAR
          </span>
          <div class="w-12 h-12 rounded-2xl bg-purple-500/10
                      flex items-center justify-center text-2xl mb-4">
            💼
          </div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Vonexa</p>
          <h3 class="text-xl font-black mt-0.5">Professional</h3>
          <p class="text-sm text-slate-500 mt-1">Build credibility. Get discovered.</p>
          <p class="mt-5 text-3xl font-black text-white">₹4,999</p>
          <p class="text-xs text-slate-500 font-semibold">ONE-TIME</p>
          <a href="/enquiry?package=<%= encodeURIComponent('Vonexa Professional') %>"
             class="mt-6 block text-center py-3 rounded-xl font-bold text-sm
                    bg-gradient-to-r from-indigo-600 to-purple-600
                    text-white hover:from-indigo-500 hover:to-purple-500 transition">
            CHOOSE PROFESSIONAL
          </a>
        </div>

        <div class="bg-slate-900/80 border border-amber-500/30
                    rounded-3xl p-6 flex flex-col
                    hover:border-amber-400/50 transition-all duration-300">
          <div class="w-12 h-12 rounded-2xl bg-amber-500/10
                      flex items-center justify-center text-2xl mb-4">
            👑
          </div>
          <p class="text-xs font-bold uppercase tracking-widest text-slate-500">Vonexa</p>
          <h3 class="text-xl font-black mt-0.5">Business Plus</h3>
          <p class="text-sm text-slate-500 mt-1">Complete digital solution to grow</p>
          <p class="mt-5 text-3xl font-black text-white">₹8,999</p>
          <p class="text-xs text-slate-500 font-semibold">ONE-TIME</p>
          <a href="/enquiry?package=<%= encodeURIComponent('Vonexa Business Plus') %>"
             class="mt-6 block text-center py-3 rounded-xl font-bold text-sm
                    border border-amber-500/40 text-amber-300
                    hover:bg-amber-500/10 transition">
            GO BUSINESS PLUS
          </a>
        </div>

      </div>

    </section>


    <!-- TESTIMONIALS -->

    <section class="relative max-w-7xl mx-auto px-6 py-16">

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-10">

        <div>
          <p class="text-indigo-400 text-sm font-semibold uppercase tracking-widest">
            Testimonials
          </p>
          <h2 class="text-3xl md:text-4xl font-bold mt-2">
            What our clients say
          </h2>

          <% if (reviewCount > 0) { %>
            <div class="mt-3 inline-flex items-center gap-2
                        bg-white/5 border border-white/10
                        rounded-full px-4 py-2">
              <span class="text-amber-400">★</span>
              <span class="font-bold text-sm"><%= avgRating.toFixed(1) %></span>
              <span class="text-slate-500 text-xs">
                from <%= reviewCount %> review<%= reviewCount === 1 ? '' : 's' %>
              </span>
            </div>
          <% } %>

        </div>

        <a href="/reviews"
           class="inline-flex items-center gap-2
                  text-indigo-400 font-semibold
                  hover:text-indigo-300 transition w-fit">
          Leave a review →
        </a>

      </div>

      <% if (reviews.length === 0) { %>

        <div class="bg-slate-900/80 border border-white/10
                    rounded-3xl p-12 text-center">
          <p class="text-slate-500">
            No reviews yet — be the first to share your experience.
          </p>
          <a href="/reviews"
             class="inline-flex mt-5 px-6 py-3 rounded-xl
                    bg-gradient-to-r from-indigo-600 to-purple-600
                    font-semibold hover:from-indigo-500 hover:to-purple-500
                    transition">
            Leave a Review
          </a>
        </div>

      <% } else { %>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">

          <% reviews.forEach(function(review) {
               const initials = (review.name || '?')
                 .split(' ')
                 .filter(Boolean)
                 .slice(0, 2)
                 .map(function(w) { return w[0].toUpperCase(); })
                 .join('');
          %>

            <div class="bg-slate-900/80 border border-white/10
                        rounded-3xl p-6
                        hover:border-indigo-500/30 transition-all duration-300">

              <div class="flex items-center justify-between gap-3">

                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full
                              bg-gradient-to-br from-indigo-500 to-purple-600
                              flex items-center justify-center
                              text-sm font-bold text-white shrink-0">
                    <%= initials %>
                  </div>
                  <div>
                    <p class="font-bold text-sm text-slate-100"><%= review.name %></p>
                    <% if (review.package) { %>
                      <p class="text-xs text-slate-500"><%= review.package %></p>
                    <% } %>
                  </div>
                </div>

                <div class="text-amber-400 text-xs whitespace-nowrap">
                  <% for (let i = 0; i < 5; i++) { %>
                    <%= i < review.rating ? '★' : '☆' %>
                  <% } %>
                </div>

              </div>

              <p class="mt-4 text-sm text-slate-400 leading-relaxed line-clamp-4">
                <%= review.message %>
              </p>

            </div>

          <% }); %>

        </div>

      <% } %>

    </section>


    <!-- WHATSAPP CTA -->

    <section class="relative max-w-7xl mx-auto px-6 pb-20">

      <a
        href="https://wa.me/919511953158"
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center justify-between gap-4
               bg-gradient-to-r from-indigo-600 to-purple-600
               rounded-3xl px-8 py-6
               shadow-xl shadow-indigo-900/30
               hover:from-indigo-500 hover:to-purple-500
               transition"
      >

        <div class="flex items-center gap-4">

          <div class="w-12 h-12 rounded-2xl
                      bg-white/15
                      flex items-center justify-center
                      text-2xl">
            💬
          </div>

          <div>
            <p class="font-bold text-lg">Let's Grow Your Business</p>
            <p class="text-indigo-100 text-sm">Chat with us on WhatsApp — we usually reply within minutes.</p>
          </div>

        </div>

        <span class="text-xl">→</span>

      </a>

    </section>

  </div>


  <!-- Footer -->

  <footer class="border-t border-white/10">

    <div class="max-w-7xl mx-auto px-6 py-8
                flex flex-col md:flex-row
                justify-between items-center gap-3">

      <p class="text-slate-500 text-sm">
        © <%= new Date().getFullYear() %> Vonexa Digital Solutions
      </p>

      <p class="text-slate-600 text-sm">
        Websites. Marketing. Growth.
      </p>

    </div>

  </footer>

</body>
</html>
