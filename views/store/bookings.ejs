<%- include('../partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

  <%- include('../partials/navbar') %>


  <div class="relative overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute -top-32 -right-32
                w-96 h-96
                bg-indigo-600/20
                rounded-full
                blur-3xl">
    </div>

    <div class="absolute -bottom-32 -left-32
                w-96 h-96
                bg-purple-600/20
                rounded-full
                blur-3xl">
    </div>


    <main class="relative max-w-5xl mx-auto px-6 py-20">


      <!-- Hero -->

      <section class="text-center">

        <div class="mx-auto mb-7
                    flex h-24 w-24
                    items-center justify-center
                    rounded-3xl
                    bg-indigo-500/10
                    border border-indigo-400/20">

          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="h-12 w-12 text-indigo-400"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="1.5"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M13 10V3L4 14h7v7l9-11h-7z"
            />
          </svg>

        </div>

        <span class="inline-flex items-center
                     rounded-full
                     bg-indigo-500/10
                     border border-indigo-400/20
                     px-4 py-2
                     text-sm font-semibold
                     text-indigo-300">

          ABOUT VONEXA

        </span>

        <h1 class="mt-6
                   text-4xl sm:text-6xl
                   font-black
                   tracking-tight
                   leading-tight">

          Digital solutions,
          <span class="text-transparent bg-clip-text
                       bg-gradient-to-r from-indigo-400 to-purple-400">
            built for growth.
          </span>

        </h1>

        <p class="max-w-2xl mx-auto
                  mt-5
                  text-base sm:text-lg
                  leading-7
                  text-slate-400">

          Vonexa helps local businesses get online, get discovered,
          and get more customers — with websites, digital tools,
          marketing and growth, all under one roof.

        </p>

        <div class="w-16 h-1
                    bg-gradient-to-r
                    from-indigo-500
                    to-purple-500
                    rounded-full
                    mx-auto
                    my-8">
        </div>

      </section>


      <!-- Story -->

      <section class="mt-6 grid grid-cols-1 md:grid-cols-2 gap-8 items-center">

        <div class="bg-slate-900/80
                    border border-white/10
                    rounded-3xl p-8">

          <p class="text-xs font-bold uppercase tracking-widest text-indigo-400 mb-3">
            Our Story
          </p>

          <h2 class="text-2xl font-black mb-4">
            Why Vonexa exists
          </h2>

          <p class="text-slate-400 leading-relaxed">
            Most small and local businesses know they need a strong
            digital presence, but don't have the time, team, or
            technical know-how to build one. Vonexa was started to
            close that gap — offering websites, branding, SEO, and
            marketing as simple, ready-to-go packages instead of
            confusing, piecemeal projects.
          </p>

          <p class="text-slate-400 leading-relaxed mt-4">
            Whether you're a restaurant, a clinic, a retail shop, or
            a growing brand, we build the digital foundation you need
            to be found, trusted, and chosen by more customers.
          </p>

        </div>

        <div class="bg-slate-900/80
                    border border-white/10
                    rounded-3xl p-8">

          <p class="text-xs font-bold uppercase tracking-widest text-purple-400 mb-3">
            Our Mission
          </p>

          <h2 class="text-2xl font-black mb-4">
            One roof, every tool
          </h2>

          <p class="text-slate-400 leading-relaxed">
            We believe every business — not just large brands —
            deserves a professional online presence. Our mission is
            to make that accessible: clear pricing, fast delivery,
            and real support, so you can focus on running your
            business while we handle the digital side.
          </p>

        </div>

      </section>


      <!-- Values -->

      <section class="mt-14">

        <p class="text-center text-xs font-bold uppercase tracking-widest text-slate-500 mb-8">
          What You Can Expect
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">

          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-5 py-4">
            <span class="text-xl">🛡️</span>
            <div>
              <p class="text-sm font-semibold text-slate-200">Professional Quality</p>
              <p class="text-xs text-slate-500">Top-notch designs & content</p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-5 py-4">
            <span class="text-xl">⏱️</span>
            <div>
              <p class="text-sm font-semibold text-slate-200">On-Time Delivery</p>
              <p class="text-xs text-slate-500">We respect your time</p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-5 py-4">
            <span class="text-xl">🎧</span>
            <div>
              <p class="text-sm font-semibold text-slate-200">Dedicated Support</p>
              <p class="text-xs text-slate-500">We're always here to help</p>
            </div>
          </div>

          <div class="flex items-center gap-3 bg-white/5 border border-white/10 rounded-2xl px-5 py-4">
            <span class="text-xl">🔒</span>
            <div>
              <p class="text-sm font-semibold text-slate-200">Secure & Reliable</p>
              <p class="text-xs text-slate-500">Safe. Fast. Reliable.</p>
            </div>
          </div>

        </div>

      </section>


      <!-- CTA -->

      <section class="mt-16 text-center">

        <div class="flex flex-col sm:flex-row justify-center gap-3">

          <a
            href="/homes"
            class="inline-flex
                   items-center
                   justify-center
                   gap-2
                   rounded-xl
                   bg-gradient-to-r
                   from-indigo-600
                   to-purple-600
                   px-7 py-3.5
                   text-sm font-bold
                   text-white
                   shadow-lg
                   shadow-indigo-900/30
                   transition
                   hover:from-indigo-500
                   hover:to-purple-500
                   hover:-translate-y-0.5"
          >

            View Our Packages

          </a>

          <a
            href="https://wa.me/919511953158"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex
                   items-center
                   justify-center
                   gap-2
                   rounded-xl
                   border
                   border-white/10
                   bg-white/5
                   px-7 py-3.5
                   text-sm font-bold
                   text-slate-300
                   transition
                   hover:bg-white/10
                   hover:text-white"
          >

            💬 Chat with Us

          </a>

        </div>

        <p class="mt-10
                  text-xs
                  uppercase
                  tracking-[0.3em]
                  text-slate-700">

          VONEXA · Websites. Marketing. Growth.

        </p>

      </section>

    </main>

  </div>

</body>
</html>
