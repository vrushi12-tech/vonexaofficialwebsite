<%- include('../partials/head') %>
</head>

<body class="min-h-screen bg-slate-950 text-white">

  <%- include('../partials/navbar') %>

  <!-- Background -->
  <main class="relative overflow-hidden">

    <div class="absolute inset-0 bg-gradient-to-br from-indigo-950 via-slate-950 to-purple-950"></div>

    <div class="absolute -top-40 -right-40
                w-96 h-96
                bg-purple-600/20
                rounded-full
                blur-3xl">
    </div>

    <div class="absolute -bottom-40 -left-40
                w-96 h-96
                bg-blue-600/20
                rounded-full
                blur-3xl">
    </div>


    <section class="relative max-w-6xl mx-auto px-6 py-16 sm:py-20">

      <!-- Heading -->
      <div class="text-center mb-14">

        <span class="inline-block
                     px-4 py-2
                     rounded-full
                     bg-indigo-500/10
                     border border-indigo-500/20
                     text-indigo-300
                     text-sm font-semibold">

          CONTACT VONEXA

        </span>

        <h1 class="mt-5
                   text-4xl sm:text-5xl lg:text-6xl
                   font-extrabold
                   tracking-tight">

          Let's Connect.

        </h1>

        <p class="mt-5
                  max-w-2xl
                  mx-auto
                  text-slate-400
                  text-lg
                  leading-8">

          Have a question, need a digital solution, or want to
          discuss your business requirements? We're here to help.

        </p>

      </div>


      <!-- Contact Cards -->
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-4xl mx-auto">


        <!-- Email -->
        <a
          href="mailto:team@vonexa.in"
          class="group bg-slate-900/80
                 border border-white/10
                 rounded-3xl
                 p-7
                 hover:border-indigo-500/50
                 hover:bg-slate-900
                 transition-all duration-300"
        >

          <div class="flex items-center gap-5">

            <div class="w-14 h-14
                        rounded-2xl
                        bg-indigo-500/10
                        flex items-center
                        justify-center
                        text-2xl">

              ✉️

            </div>

            <div>

              <p class="text-sm text-slate-500">
                Email
              </p>

              <h2 class="mt-1
                         text-lg
                         font-bold
                         group-hover:text-indigo-400
                         transition">

                team@vonexa.in

              </h2>

            </div>

          </div>

        </a>


        <!-- Phone -->
        <a
          href="tel:+919309285318"
          class="group bg-slate-900/80
                 border border-white/10
                 rounded-3xl
                 p-7
                 hover:border-blue-500/50
                 hover:bg-slate-900
                 transition-all duration-300"
        >

          <div class="flex items-center gap-5">

            <div class="w-14 h-14
                        rounded-2xl
                        bg-blue-500/10
                        flex items-center
                        justify-center
                        text-2xl">

              📞

            </div>

            <div>

              <p class="text-sm text-slate-500">
                Call Us
              </p>

              <h2 class="mt-1 text-lg font-bold">
                9309285318
              </h2>

            </div>

          </div>

        </a>


        <!-- Second Phone -->
        <a
          href="tel:+919511953158"
          class="group bg-slate-900/80
                 border border-white/10
                 rounded-3xl
                 p-7
                 hover:border-blue-500/50
                 hover:bg-slate-900
                 transition-all duration-300"
        >

          <div class="flex items-center gap-5">

            <div class="w-14 h-14
                        rounded-2xl
                        bg-blue-500/10
                        flex items-center
                        justify-center
                        text-2xl">

              📱

            </div>

            <div>

              <p class="text-sm text-slate-500">
                Call / WhatsApp
              </p>

              <h2 class="mt-1 text-lg font-bold">
                9511953158
              </h2>

            </div>

          </div>

        </a>


        <!-- Instagram -->
        <a
          href="https://instagram.com/vonexa.official"
          target="_blank"
          rel="noopener noreferrer"
          class="group bg-slate-900/80
                 border border-white/10
                 rounded-3xl
                 p-7
                 hover:border-pink-500/50
                 hover:bg-slate-900
                 transition-all duration-300"
        >

          <div class="flex items-center gap-5">

            <div class="w-14 h-14
                        rounded-2xl
                        bg-pink-500/10
                        flex items-center
                        justify-center
                        text-2xl">

              📸

            </div>

            <div>

              <p class="text-sm text-slate-500">
                Instagram
              </p>

              <h2 class="mt-1 text-lg font-bold">
                @vonexa.official
              </h2>

            </div>

          </div>

        </a>

      </div>


      <!-- WhatsApp Highlight -->
      <div class="max-w-4xl mx-auto mt-8">

        <a
          href="https://wa.me/919511953158"
          target="_blank"
          rel="noopener noreferrer"
          class="group block
                 rounded-3xl
                 border border-emerald-500/20
                 bg-emerald-500/5
                 p-7
                 hover:bg-emerald-500/10
                 hover:border-emerald-500/40
                 transition-all duration-300"
        >

          <div class="flex flex-col sm:flex-row
                      items-center
                      justify-between
                      gap-5">

            <div class="flex items-center gap-5">

              <div class="w-14 h-14
                          rounded-2xl
                          bg-emerald-500/10
                          flex items-center
                          justify-center
                          text-2xl">

                💬

              </div>

              <div>

                <p class="text-sm text-emerald-400 font-semibold">
                  QUICK RESPONSE
                </p>

                <h2 class="mt-1 text-xl font-bold">
                  Chat with us on WhatsApp
                </h2>

                <p class="text-sm text-slate-500 mt-1">
                  9511953158
                </p>

              </div>

            </div>

            <span class="text-emerald-400
                         text-2xl
                         group-hover:translate-x-1
                         transition">

              →

            </span>

          </div>

        </a>

      </div>


      <!-- Bottom -->
      <div class="text-center mt-16">

        <div class="w-16 h-px bg-gradient-to-r
                    from-transparent
                    via-indigo-500
                    to-transparent
                    mx-auto mb-6">
        </div>

        <p class="text-sm text-slate-500">
          VONEXA — DIGITAL SOLUTIONS
        </p>

        <p class="mt-2 text-xs text-slate-700">
          Websites • Digital Tools • Marketing • Growth
        </p>

      </div>

    </section>

  </main>

</body>
</html>