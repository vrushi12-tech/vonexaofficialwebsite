<form action="/favourite-list" method="POST" class="flex-1">

  <input
    type="hidden"
    name="homeId"
    value="<%= home.id %>"
  >

  <button
    type="submit"
    class="w-full
           inline-flex
           items-center
           justify-center
           gap-2
           px-6
           py-3.5
           rounded-xl
           bg-white/5
           border border-white/10
           text-slate-300
           font-semibold
           hover:bg-pink-500/10
           hover:border-pink-500/30
           hover:text-pink-400
           transition-all duration-300"
  >

    <svg
      class="w-5 h-5"
      fill="none"
      viewBox="0 0 24 24"
      stroke="currentColor"
      stroke-width="2"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78L12 21.23l8.84-8.84a5.5 5.5 0 000-7.78z"
      />
    </svg>

    Add to Favourite

  </button>

</form>