<header class="sticky top-0 z-50 bg-slate-950/95 backdrop-blur-xl border-b border-white/10">

  <div class="max-w-7xl mx-auto px-6">

    <div class="h-20 flex items-center justify-between">

      <!-- VONEXA BRAND -->

      <a href="/services" class="flex items-center gap-3 group">

        <div class="w-11 h-11 rounded-xl
                    bg-gradient-to-br from-indigo-500 to-purple-600
                    p-[3px]
                    shadow-lg shadow-indigo-500/20
                    group-hover:scale-105
                    transition-transform duration-300">

          <div class="w-full h-full rounded-[10px]
                      bg-slate-950
                      flex items-center justify-center
                      overflow-hidden">

            <img
              src="https://res.cloudinary.com/dgbscbi0q/image/upload/v1786702056/Untitled_design_20260814_135748_0000_lfsc1t.png"
              alt="VONEXA"
              class="w-full h-full object-contain"
            >

          </div>

        </div>

        <div>
          <h1 class="text-xl font-black tracking-tight text-white leading-none">
            VONEXA
          </h1>

          <p class="text-[9px] uppercase tracking-[0.25em] text-indigo-400 mt-1">
            Admin Panel
          </p>
        </div>

      </a>


      <!-- DESKTOP NAVIGATION -->

      <nav class="hidden md:flex items-center gap-1" id="desktop-nav">

        <a href="/services" data-nav
           class="nav-link px-4 py-2.5 rounded-xl text-slate-300 font-medium
                  hover:text-white hover:bg-white/5 transition">
          🧰 Services
        </a>

        <a href="/manage-demos" data-nav
           class="nav-link px-4 py-2.5 rounded-xl text-slate-300
                  hover:text-white hover:bg-white/5 transition">
          🖼️ Demos
        </a>

        <a href="/enquiries" data-nav
           class="nav-link px-4 py-2.5 rounded-xl text-slate-300
                  hover:text-white hover:bg-white/5 transition">
          📩 Enquiries
        </a>

        <a href="/revenue" data-nav
           class="nav-link px-4 py-2.5 rounded-xl text-slate-300
                  hover:text-white hover:bg-white/5 transition">
          💰 Revenue
        </a>

        <a href="/manage-reviews" data-nav
           class="nav-link px-4 py-2.5 rounded-xl text-slate-300
                  hover:text-white hover:bg-white/5 transition">
          ★ Reviews
        </a>

      </nav>


      <!-- RIGHT SIDE -->

      <div class="flex items-center gap-3">

        <form action="/logout" method="POST" class="hidden sm:block">
          <button
            type="submit"
            class="flex items-center gap-2
                   px-5 py-2.5 rounded-xl
                   border border-white/10
                   bg-white/5
                   text-slate-300 font-semibold
                   hover:bg-red-500/10 hover:text-red-300 hover:border-red-500/20
                   transition"
          >
            Logout
          </button>
        </form>

        <a
          href="/"
          class="hidden sm:flex items-center gap-2
                 px-5 py-2.5 rounded-xl
                 border border-white/10
                 bg-white/5
                 text-slate-300 font-semibold
                 hover:bg-white/10 hover:text-white
                 transition"
        >
          ← View Site
        </a>


        <!-- MOBILE MENU BUTTON -->

        <button
          type="button"
          id="mobile-menu-btn"
          aria-label="Toggle menu"
          aria-expanded="false"
          class="md:hidden w-10 h-10 rounded-xl
                 border border-white/10
                 bg-white/5
                 text-white
                 hover:bg-white/10
                 transition
                 flex items-center justify-center"
        >
          <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 hidden" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
          </svg>
        </button>

      </div>

    </div>


    <!-- MOBILE MENU PANEL -->

    <div id="mobile-menu" class="hidden md:hidden pb-5">

      <nav class="flex flex-col gap-1">

        <a href="/services" data-nav class="nav-link px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">
          🧰 Services
        </a>

        <a href="/manage-demos" data-nav class="nav-link px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">
          🖼️ Demos
        </a>

        <a href="/enquiries" data-nav class="nav-link px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">
          📩 Enquiries
        </a>

        <a href="/revenue" data-nav class="nav-link px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">
          💰 Revenue
        </a>

        <a href="/manage-reviews" data-nav class="nav-link px-4 py-3 rounded-xl text-slate-300 hover:text-white hover:bg-white/5 transition">
          ★ Reviews
        </a>

        <a
          href="/"
          class="mt-2 flex items-center justify-center gap-2
                 px-5 py-3 rounded-xl
                 border border-white/10 bg-white/5
                 text-slate-300 font-semibold
                 transition"
        >
          ← View Site
        </a>

        <form action="/logout" method="POST">
          <button
            type="submit"
            class="w-full flex items-center justify-center gap-2
                   px-5 py-3 rounded-xl
                   border border-white/10 bg-white/5
                   text-slate-300 font-semibold
                   hover:bg-red-500/10 hover:text-red-300
                   transition"
          >
            Logout
          </button>
        </form>

      </nav>

    </div>

  </div>

</header>


<script>
  (function () {
    var btn = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    var iconOpen = document.getElementById('icon-open');
    var iconClose = document.getElementById('icon-close');

    if (btn && menu) {
      btn.addEventListener('click', function () {
        var isHidden = menu.classList.contains('hidden');
        menu.classList.toggle('hidden');
        iconOpen.classList.toggle('hidden');
        iconClose.classList.toggle('hidden');
        btn.setAttribute('aria-expanded', isHidden ? 'true' : 'false');
      });
    }

    // Highlight the active nav link based on current path
    var path = window.location.pathname;
    document.querySelectorAll('[data-nav]').forEach(function (link) {
      var href = link.getAttribute('href');
      var isActive = path.indexOf(href) === 0;
      if (isActive) {
        link.classList.add('bg-white/10', 'text-white');
        link.classList.remove('text-slate-300');
      }
    });
  })();
</script>
