<%- include('./partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

  <%- include('./partials/navbar.ejs') %>


  <!-- Background -->

  <div class="relative flex-1 overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute -top-32 -right-32
                w-96 h-96
                bg-indigo-600/20
                rounded-full
                blur-3xl">
    </div>

    <div class="absolute -bottom-32 -left-32
                w-96 h-96
                bg-purple-600/20
                rounded-full
                blur-3xl">
    </div>


    <!-- Form Container -->

    <main class="relative max-w-6xl mx-auto px-6 py-16">

      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">


        <!-- Left Content -->

        <section>

          <span class="inline-block
                       px-4 py-2
                       rounded-full
                       bg-white/10
                       border border-white/10
                       text-indigo-300
                       text-sm font-semibold">
            ✦ VONEXA ENQUIRY
          </span>


          <h1 class="mt-6
                     text-4xl md:text-6xl
                     font-black
                     leading-tight">

            Let's grow your
            <span class="text-transparent
                         bg-clip-text
                         bg-gradient-to-r
                         from-indigo-400
                         to-purple-400">
              business.
            </span>

          </h1>


          <p class="mt-6
                    text-lg
                    text-slate-400
                    max-w-lg
                    leading-relaxed">

            Interested in a package or service?
            Send us your details and our team will get
            in touch with you.

          </p>


          <div class="mt-8 space-y-4">

            <div class="flex items-center gap-4">

              <div class="w-11 h-11 rounded-xl
                          bg-indigo-500/10
                          flex items-center justify-center">
                📦
              </div>

              <div>
                <p class="font-semibold">
                  Choose your package
                </p>

                <p class="text-sm text-slate-500">
                  Tell us which service interests you.
                </p>
              </div>

            </div>


            <div class="flex items-center gap-4">

              <div class="w-11 h-11 rounded-xl
                          bg-purple-500/10
                          flex items-center justify-center">
                💬
              </div>

              <div>
                <p class="font-semibold">
                  Send an enquiry
                </p>

                <p class="text-sm text-slate-500">
                  Our team will review your request.
                </p>
              </div>

            </div>

          </div>

        </section>


        <!-- Form -->

        <section>

          <div class="bg-slate-900/90
                      backdrop-blur-xl
                      border border-white/10
                      rounded-3xl
                      p-7 md:p-9
                      shadow-2xl">

            <div class="mb-7">

              <h2 class="text-2xl font-bold">
                Send an Enquiry
              </h2>

              <p class="text-slate-500 mt-2 text-sm">
                Fill in your details and we'll get back to you.
              </p>

            </div>


            <form
              id="enquiryForm"
              action="/enquiry"
              method="POST"
              class="space-y-5"
            >


              <!-- Name -->

              <div>

                <label class="block text-sm
                              font-medium
                              text-slate-300
                              mb-2">
                  Your Name
                </label>

                <input
                  type="text"
                  name="name"
                  placeholder="Enter your name"
                  required
                  class="w-full
                         px-4 py-3
                         rounded-xl
                         bg-slate-950
                         border border-white/10
                         text-white
                         placeholder-slate-600
                         focus:outline-none
                         focus:border-indigo-500
                         focus:ring-2
                         focus:ring-indigo-500/20
                         transition"
                >

              </div>


              <!-- Phone -->

              <div>

                <label class="block text-sm
                              font-medium
                              text-slate-300
                              mb-2">
                  Phone Number
                </label>

                <input
                  type="tel"
                  name="phone"
                  placeholder="Enter your phone number"
                  required
                  class="w-full
                         px-4 py-3
                         rounded-xl
                         bg-slate-950
                         border border-white/10
                         text-white
                         placeholder-slate-600
                         focus:outline-none
                         focus:border-indigo-500
                         focus:ring-2
                         focus:ring-indigo-500/20
                         transition"
                >

              </div>


              <!-- Email -->

              <div>

                <label class="block text-sm
                              font-medium
                              text-slate-300
                              mb-2">
                  Email
                </label>

                <input
                  type="email"
                  name="email"
                  placeholder="you@example.com"
                  class="w-full
                         px-4 py-3
                         rounded-xl
                         bg-slate-950
                         border border-white/10
                         text-white
                         placeholder-slate-600
                         focus:outline-none
                         focus:border-indigo-500
                         focus:ring-2
                         focus:ring-indigo-500/20
                         transition"
                >

              </div>


              <!-- Package / Service -->

              <div>

                <label class="block text-sm
                              font-medium
                              text-slate-300
                              mb-2">
                  Package / Service
                </label>

                <select
                  id="package"
                  name="package"
                  required
                  class="w-full
                         px-4 py-3
                         rounded-xl
                         bg-slate-950
                         border border-white/10
                         text-white
                         focus:outline-none
                         focus:border-indigo-500
                         focus:ring-2
                         focus:ring-indigo-500/20
                         transition"
                >
                  <option value="" disabled selected>Select a package or service</option>
                  <optgroup label="One-Time Packages">
                    <option value="Vonexa Essential">Vonexa Essential — ₹3,499</option>
                    <option value="Vonexa Professional">Vonexa Professional — ₹4,999</option>
                    <option value="Vonexa Business Plus">Vonexa Business Plus — ₹8,999</option>
                  </optgroup>
                  <optgroup label="Monthly Marketing & Growth">
                    <option value="Vonexa Social">Vonexa Social — ₹3,999/mo</option>
                    <option value="Vonexa Social Plus">Vonexa Social Plus — ₹6,999/mo</option>
                    <option value="Vonexa Digital Growth">Vonexa Digital Growth — ₹14,999/mo</option>
                  </optgroup>
                  <optgroup label="Custom Services">
                    <option value="Landing Page">Landing Page</option>
                    <option value="Business Website">Business Website</option>
                    <option value="NFC Business Card">NFC Business Card</option>
                    <option value="QR Menu + Stand">QR Menu + Stand</option>
                    <option value="Google Profile Optimization">Google Profile Optimization</option>
                    <option value="Basic Local SEO">Basic Local SEO</option>
                    <option value="Social Media Setup">Social Media Setup</option>
                    <option value="Logo Design">Logo Design</option>
                    <option value="Custom Web Features">Custom Web Features</option>
                  </optgroup>
                  <optgroup label="Video Shoot & Content">
                    <option value="Business / Reel Video Shooting">Business / Reel Video Shooting</option>
                    <option value="Product Video Shooting">Product Video Shooting</option>
                    <option value="Restaurant / Food Video">Restaurant / Food Video</option>
                    <option value="Promotional Video">Promotional Video</option>
                    <option value="Reel Editing">Reel Editing</option>
                    <option value="5 Reels Package">5 Reels Package</option>
                    <option value="10 Reels Package">10 Reels Package</option>
                  </optgroup>
                  <option value="Other">Other / Not sure yet</option>
                </select>

              </div>


              <!-- Message -->

              <div>

                <label class="block text-sm
                              font-medium
                              text-slate-300
                              mb-2">
                  Message
                </label>

                <textarea
                  name="message"
                  rows="4"
                  placeholder="Tell us what you're looking for..."
                  class="w-full
                         px-4 py-3
                         rounded-xl
                         bg-slate-950
                         border border-white/10
                         text-white
                         placeholder-slate-600
                         resize-none
                         focus:outline-none
                         focus:border-indigo-500
                         focus:ring-2
                         focus:ring-indigo-500/20
                         transition"
                ></textarea>

              </div>


              <!-- Submit -->

              <button
                type="submit"
                id="enquirySubmitBtn"
                class="w-full
                       py-3.5
                       rounded-xl
                       bg-gradient-to-r
                       from-indigo-600
                       to-purple-600
                       text-white
                       font-bold
                       shadow-lg
                       shadow-indigo-900/30
                       hover:from-indigo-500
                       hover:to-purple-500
                       hover:-translate-y-0.5
                       transition
                       disabled:opacity-70
                       disabled:cursor-not-allowed
                       disabled:hover:translate-y-0
                       flex items-center justify-center gap-2"
              >
                <svg id="enquirySpinner" class="hidden animate-spin h-5 w-5" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                <span id="enquirySubmitText">Send Enquiry →</span>
              </button>


              <p id="enquiryWaitNote" class="hidden text-center text-xs text-indigo-400">
                First submission can take up to a minute while our server wakes up. Please don't close this page.
              </p>

              <p class="text-center text-xs text-slate-600">
                Your information will only be used to respond to your enquiry.
              </p>

            </form>

          </div>

        </section>

      </div>


      <script>
        (function () {
          const form = document.getElementById('enquiryForm');
          const btn = document.getElementById('enquirySubmitBtn');
          const spinner = document.getElementById('enquirySpinner');
          const text = document.getElementById('enquirySubmitText');
          const waitNote = document.getElementById('enquiryWaitNote');

          if (form) {
            form.addEventListener('submit', function () {
              btn.disabled = true;
              spinner.classList.remove('hidden');
              text.textContent = 'Sending...';
              waitNote.classList.remove('hidden');
              // Not calling preventDefault() -- the form still submits normally,
              // this just gives the user visual feedback while it's in flight.
            });
          }
        })();
      </script>

    </main>

  </div>


  <!-- Footer -->

  <footer class="border-t border-white/10">

    <div class="max-w-7xl mx-auto px-6 py-6 text-center">

      <p class="text-sm text-slate-600">
        © <%= new Date().getFullYear() %> Vonexa
      </p>

    </div>

  </footer>


  <!-- Prefill package from URL, e.g. /enquiry?package=Vonexa%20Professional -->
  <script>
    (function () {
      var params = new URLSearchParams(window.location.search);
      var pkg = params.get('package');
      if (pkg) {
        var select = document.getElementById('package');
        var matched = false;
        for (var i = 0; i < select.options.length; i++) {
          if (select.options[i].value === pkg) {
            select.value = pkg;
            matched = true;
            break;
          }
        }
        if (!matched) {
          var opt = document.createElement('option');
          opt.value = pkg;
          opt.textContent = pkg;
          opt.selected = true;
          select.insertBefore(opt, select.firstChild);
        }
      }
    })();
  </script>

</body>
</html>
