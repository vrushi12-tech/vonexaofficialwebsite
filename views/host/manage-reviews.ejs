<%- include('../partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

<%-include('../partials/host-nav') %>

  <div class="relative min-h-screen overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute top-0 right-0
                w-96 h-96
                bg-indigo-600/10
                rounded-full
                blur-3xl">
    </div>


    <main class="relative max-w-7xl mx-auto px-6 py-10">


      <!-- HEADER -->

      <div class="flex flex-col
                  lg:flex-row
                  lg:items-center
                  lg:justify-between
                  gap-6 mb-10">

        <div>

          <p class="text-indigo-400 text-sm font-semibold uppercase tracking-[0.2em]">
            ADMIN PANEL
          </p>

          <h1 class="mt-2 text-3xl md:text-4xl font-black">
            Manage Reviews
          </h1>

          <p class="mt-2 text-slate-500">
            Add or remove client testimonials shown on your site.
          </p>

        </div>

        <div class="flex items-center gap-3
                    bg-slate-900/80 border border-white/10
                    rounded-2xl px-5 py-4 w-fit">
          <span class="text-2xl">★</span>
          <div>
            <p class="text-lg font-black leading-none">
              <%= avgRating.toFixed(1) %>
            </p>
            <p class="text-xs text-slate-500 mt-1">
              <%= reviews.length %> review<%= reviews.length === 1 ? '' : 's' %>
            </p>
          </div>
        </div>

      </div>


      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">


        <!-- ADD REVIEW FORM -->

        <div class="lg:col-span-2">

          <div class="bg-slate-900/90 backdrop-blur-xl
                      border border-white/10
                      rounded-3xl p-7
                      shadow-2xl sticky top-24">

            <h2 class="text-xl font-bold">Add a Review</h2>
            <p class="text-slate-500 text-sm mt-1">
              Add a testimonial on behalf of a client.
            </p>

            <form action="/manage-reviews/add" method="POST" class="space-y-5 mt-6">

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Client Name</label>
                <input type="text" name="name" placeholder="Enter client name" required
                       class="w-full px-4 py-3 rounded-xl bg-slate-950
                              border border-white/10 text-white placeholder-slate-600
                              focus:outline-none focus:border-indigo-500
                              focus:ring-2 focus:ring-indigo-500/20 transition">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Rating</label>
                <select name="rating" required
                        class="w-full px-4 py-3 rounded-xl bg-slate-950
                               border border-white/10 text-white
                               focus:outline-none focus:border-indigo-500
                               focus:ring-2 focus:ring-indigo-500/20 transition">
                  <option value="5" selected>★★★★★ (5)</option>
                  <option value="4">★★★★☆ (4)</option>
                  <option value="3">★★★☆☆ (3)</option>
                  <option value="2">★★☆☆☆ (2)</option>
                  <option value="1">★☆☆☆☆ (1)</option>
                </select>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Package (optional)</label>
                <input type="text" name="package" placeholder="e.g. Vonexa Professional"
                       class="w-full px-4 py-3 rounded-xl bg-slate-950
                              border border-white/10 text-white placeholder-slate-600
                              focus:outline-none focus:border-indigo-500
                              focus:ring-2 focus:ring-indigo-500/20 transition">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Review Message</label>
                <textarea name="message" rows="4" placeholder="What did they say?" required
                          class="w-full px-4 py-3 rounded-xl bg-slate-950
                                 border border-white/10 text-white placeholder-slate-600
                                 resize-none focus:outline-none focus:border-indigo-500
                                 focus:ring-2 focus:ring-indigo-500/20 transition"></textarea>
              </div>

              <button type="submit"
                      class="w-full py-3.5 rounded-xl
                             bg-gradient-to-r from-indigo-600 to-purple-600
                             text-white font-bold shadow-lg shadow-indigo-900/30
                             hover:from-indigo-500 hover:to-purple-500
                             hover:-translate-y-0.5 transition">
                Add Review →
              </button>

            </form>

          </div>

        </div>


        <!-- REVIEWS LIST -->

        <div class="lg:col-span-3">

          <% if (reviews.length === 0) { %>

            <div class="bg-slate-900/80 border border-white/10
                        rounded-3xl p-16 text-center">

              <div class="mx-auto w-16 h-16 rounded-2xl
                          bg-indigo-500/10
                          flex items-center justify-center
                          text-3xl mb-5">
                💬
              </div>

              <h3 class="text-lg font-bold">No reviews yet</h3>
              <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                Add one using the form, or wait for clients to submit
                their own via the public reviews page.
              </p>

            </div>

          <% } else { %>

            <div class="space-y-4">

              <% reviews.forEach(function(review) {
                   const initials = (review.name || '?')
                     .split(' ')
                     .filter(Boolean)
                     .slice(0, 2)
                     .map(function(w) { return w[0].toUpperCase(); })
                     .join('');
              %>

                <div class="bg-slate-900/80 border border-white/10
                            rounded-3xl p-6
                            hover:border-indigo-500/30 transition-all duration-300">

                  <div class="flex items-start justify-between gap-4">

                    <div class="flex items-center gap-3 min-w-0">
                      <div class="w-10 h-10 shrink-0 rounded-full
                                  bg-gradient-to-br from-indigo-500 to-purple-600
                                  flex items-center justify-center
                                  text-sm font-bold text-white">
                        <%= initials %>
                      </div>
                      <div class="min-w-0">
                        <p class="font-bold text-sm text-slate-100 truncate"><%= review.name %></p>
                        <p class="text-xs text-slate-600 mt-0.5">
                          <%= review.createdAt ? new Date(review.createdAt).toLocaleDateString() : '' %>
                          <% if (review.package) { %>
                            &middot; <%= review.package %>
                          <% } %>
                        </p>
                      </div>
                    </div>

                    <div class="flex items-center gap-3 shrink-0">

                      <div class="text-amber-400 text-xs whitespace-nowrap">
                        <% for (let i = 0; i < 5; i++) { %>
                          <%= i < review.rating ? '★' : '☆' %>
                        <% } %>
                      </div>

                      <form action="/reviews/<%= review.id %>/delete" method="POST"
                            onsubmit="return confirm('Delete this review?');">
                        <button type="submit"
                                class="text-xs text-red-400 hover:text-red-300 font-semibold transition">
                          Delete
                        </button>
                      </form>

                    </div>

                  </div>

                  <p class="mt-4 text-sm text-slate-400 leading-relaxed">
                    <%= review.message %>
                  </p>

                </div>

              <% }); %>

            </div>

          <% } %>

        </div>

      </div>


      <!-- FOOTER -->

      <div class="mt-12 pt-6 border-t border-white/10
                  flex flex-col md:flex-row justify-between gap-3">
        <p class="text-xs text-slate-600">Vonexa Admin Panel</p>
        <p class="text-xs text-slate-700">Stay. Explore. Experience.</p>
      </div>

    </main>

  </div>

</body>
</html>
