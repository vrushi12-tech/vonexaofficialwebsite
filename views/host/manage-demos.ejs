<%- include('../partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

  <%- include('../partials/host-nav') %>


  <div class="relative min-h-screen overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute top-0 right-0
                w-96 h-96
                bg-indigo-600/10
                rounded-full
                blur-3xl">
    </div>


    <main class="relative max-w-7xl mx-auto px-6 py-10">


      <!-- HEADER -->

      <div class="mb-10">

        <p class="text-indigo-400 text-sm font-semibold uppercase tracking-[0.2em]">
          ADMIN PANEL
        </p>

        <h1 class="mt-2 text-3xl md:text-4xl font-black">
          Manage Demos
        </h1>

        <p class="mt-2 text-slate-500">
          Add or remove work samples shown on your public "Our Work" page.
        </p>

      </div>


      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8">


        <!-- ADD DEMO FORM -->

        <div class="lg:col-span-2">

          <div class="bg-slate-900/90 backdrop-blur-xl
                      border border-white/10
                      rounded-3xl p-7
                      shadow-2xl sticky top-24">

            <h2 class="text-xl font-bold">Add a Demo</h2>
            <p class="text-slate-500 text-sm mt-1">
              Showcase a project or sample of your work.
            </p>

            <form action="/manage-demos/add" method="POST" class="space-y-5 mt-6">

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Title</label>
                <input type="text" name="title" placeholder="e.g. Restaurant Website" required
                       class="w-full px-4 py-3 rounded-xl bg-slate-950
                              border border-white/10 text-white placeholder-slate-600
                              focus:outline-none focus:border-indigo-500
                              focus:ring-2 focus:ring-indigo-500/20 transition">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Description (optional)</label>
                <textarea name="description" rows="3" placeholder="What is this project?"
                          class="w-full px-4 py-3 rounded-xl bg-slate-950
                                 border border-white/10 text-white placeholder-slate-600
                                 resize-none focus:outline-none focus:border-indigo-500
                                 focus:ring-2 focus:ring-indigo-500/20 transition"></textarea>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Image URL (optional)</label>
                <input type="url" name="imageUrl" placeholder="https://..."
                       class="w-full px-4 py-3 rounded-xl bg-slate-950
                              border border-white/10 text-white placeholder-slate-600
                              focus:outline-none focus:border-indigo-500
                              focus:ring-2 focus:ring-indigo-500/20 transition">
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Video URL (optional)</label>
                <input type="url" name="videoUrl" placeholder="https://... (.mp4 direct link)"
                       class="w-full px-4 py-3 rounded-xl bg-slate-950
                              border border-white/10 text-white placeholder-slate-600
                              focus:outline-none focus:border-indigo-500
                              focus:ring-2 focus:ring-indigo-500/20 transition">
                <p class="text-xs text-slate-600 mt-1.5">
                  Plays automatically when a visitor hovers over the card.
                  Needs a direct video file link (.mp4) -- not a YouTube page URL.
                </p>
              </div>

              <div>
                <label class="block text-sm font-medium text-slate-300 mb-2">Live Link (optional)</label>
                <input type="url" name="link" placeholder="https://..."
                       class="w-full px-4 py-3 rounded-xl bg-slate-950
                              border border-white/10 text-white placeholder-slate-600
                              focus:outline-none focus:border-indigo-500
                              focus:ring-2 focus:ring-indigo-500/20 transition">
              </div>

              <button type="submit"
                      class="w-full py-3.5 rounded-xl
                             bg-gradient-to-r from-indigo-600 to-purple-600
                             text-white font-bold shadow-lg shadow-indigo-900/30
                             hover:from-indigo-500 hover:to-purple-500
                             hover:-translate-y-0.5 transition">
                Add Demo →
              </button>

            </form>

          </div>

        </div>


        <!-- DEMOS LIST -->

        <div class="lg:col-span-3">

          <% if (demos.length === 0) { %>

            <div class="bg-slate-900/80 border border-white/10
                        rounded-3xl p-16 text-center">

              <div class="mx-auto w-16 h-16 rounded-2xl
                          bg-indigo-500/10
                          flex items-center justify-center
                          text-3xl mb-5">
                🖼️
              </div>

              <h3 class="text-lg font-bold">No demos yet</h3>
              <p class="mt-2 text-sm text-slate-500 max-w-sm mx-auto">
                Add your first project using the form.
              </p>

            </div>

          <% } else { %>

            <div class="space-y-4">

              <% demos.forEach(function(demo) { %>

                <div class="bg-slate-900/80 border border-white/10
                            rounded-3xl p-5
                            hover:border-indigo-500/30 transition-all duration-300
                            flex gap-4 items-start">

                  <% if (demo.imageUrl) { %>
                    <img src="<%= demo.imageUrl %>" alt="<%= demo.title %>"
                         class="w-20 h-20 rounded-xl object-cover shrink-0 bg-slate-950">
                  <% } else { %>
                    <div class="w-20 h-20 rounded-xl bg-indigo-500/10
                                flex items-center justify-center text-2xl shrink-0">
                      🖼️
                    </div>
                  <% } %>

                  <div class="flex-1 min-w-0">

                    <div class="flex items-start justify-between gap-3">
                      <h3 class="font-bold text-slate-100 truncate flex items-center gap-2">
                        <%= demo.title %>
                        <% if (demo.videoUrl) { %>
                          <span class="text-xs px-2 py-0.5 rounded-full
                                       bg-indigo-500/10 border border-indigo-400/20
                                       text-indigo-300 shrink-0">
                            🎬 video
                          </span>
                        <% } %>
                      </h3>

                      <form action="/demos/<%= demo.id %>/delete" method="POST"
                            onsubmit="return confirm('Delete this demo?');">
                        <button type="submit"
                                class="text-xs text-red-400 hover:text-red-300 font-semibold transition whitespace-nowrap">
                          Delete
                        </button>
                      </form>
                    </div>

                    <% if (demo.description) { %>
                      <p class="text-sm text-slate-500 mt-1 line-clamp-2"><%= demo.description %></p>
                    <% } %>

                    <% if (demo.link) { %>
                      <a href="<%= demo.link %>" target="_blank" rel="noopener noreferrer"
                         class="text-xs text-indigo-400 hover:text-indigo-300 transition mt-2 inline-block">
                        <%= demo.link %>
                      </a>
                    <% } %>

                  </div>

                </div>

              <% }); %>

            </div>

          <% } %>

        </div>

      </div>


      <!-- FOOTER -->

      <div class="mt-12 pt-6 border-t border-white/10
                  flex flex-col md:flex-row justify-between gap-3">
        <p class="text-xs text-slate-600">Vonexa Admin Panel</p>
        <p class="text-xs text-slate-700">Stay. Explore. Experience.</p>
      </div>

    </main>

  </div>

</body>
</html>
