<%- include('../partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

 
<%-include('../partials/host-nav') %>

  <!-- Background -->

  <div class="relative min-h-screen overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute top-0 right-0
                w-96 h-96
                bg-indigo-600/10
                rounded-full
                blur-3xl">
    </div>


    <main class="relative max-w-7xl mx-auto
                 px-6 py-10">

      <%
        const statusStyles = {
          'Active':    { dot: 'bg-emerald-400', badge: 'bg-emerald-500/10 border-emerald-400/20 text-emerald-300' },
          'Pending':   { dot: 'bg-amber-400',   badge: 'bg-amber-500/10 border-amber-400/20 text-amber-300' },
          'Deactivate':  { dot: 'bg-slate-500',   badge: 'bg-slate-500/10 border-slate-400/20 text-slate-400' },
          'Complete':  { dot: 'bg-indigo-400',  badge: 'bg-indigo-500/10 border-indigo-400/20 text-indigo-300' }
        };
        function styleFor(status) {
          return statusStyles[status] || statusStyles['Pending'];
        }
        function waNumber(phone) {
          const digits = (phone || '').replace(/\D/g, '');
          if (digits.length === 10) return '91' + digits;
          if (digits.length === 12 && digits.startsWith('91')) return digits;
          return digits;
        }
        function prefillMessage(enquiry) {
          const pkg = enquiry.package ? ' about ' + enquiry.package : '';
          return 'Hi ' + (enquiry.name || '') + ', this is Vonexa regarding your enquiry' + pkg + '. ';
        }

        const priceMap = {
          'Vonexa Essential': 3499,
          'Vonexa Professional': 4999,
          'Vonexa Business Plus': 8999,
          'Vonexa Social': 3999,
          'Vonexa Social Plus': 6999,
          'Vonexa Digital Growth': 14999,
          'Landing Page': 2499,
          'Business Website': 4999,
          'NFC Business Card': 299,
          'QR Menu + Stand': 1299,
          'Google Profile Optimization': 999,
          'Basic Local SEO': 1499,
          'Social Media Setup': 999,
          'Logo Design': 999,
          'Custom Web Features': 999,
          'Business / Reel Video Shooting': 1800,
          'Product Video Shooting': 1800,
          'Restaurant / Food Video': 2300,
          'Promotional Video': 3000,
          'Reel Editing': 499,
          '5 Reels Package': 2499,
          '10 Reels Package': 4499
        };
        function priceOf(pkg) {
          return priceMap[pkg] || 0;
        }

        const completedSales = allEnquiries
          .filter((e) => e.status === 'Complete')
          .map((e) => Object.assign({}, e, { amount: priceOf(e.package) }))
          .sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));

        const totalRevenue = completedSales.reduce((sum, e) => sum + e.amount, 0);

        const now = new Date();
        const monthRevenue = completedSales
          .filter((e) => e.createdAt &&
            new Date(e.createdAt).getMonth() === now.getMonth() &&
            new Date(e.createdAt).getFullYear() === now.getFullYear())
          .reduce((sum, e) => sum + e.amount, 0);

        const avgDeal = completedSales.length
          ? Math.round(totalRevenue / completedSales.length)
          : 0;
      %>


      <!-- HEADER -->

      <div class="flex flex-col
                  lg:flex-row
                  lg:items-center
                  lg:justify-between
                  gap-6 mb-10">

        <div>

          <p class="text-indigo-400
                    text-lg font-semibold
                    uppercase tracking-[0.2em]">
            ADMIN PANEL
          </p>

          <h1 class="mt-2
                     text-3xl md:text-4xl
                     font-black">
            Enquiries
          </h1>

          <p class="mt-2 text-slate-500">
            All enquiries submitted through Vonexa.
          </p>

        </div>

        <div class="flex flex-wrap gap-3">

          <a
            href="/revenue"
            class="inline-flex items-center justify-center gap-2
                   px-6 py-3.5 rounded-xl
                   border border-white/10 bg-white/5
                   text-white font-bold
                   hover:bg-white/10
                   transition w-fit"
          >
            💰 Revenue
          </a>

          <a
            href="/manage-reviews"
            class="inline-flex items-center justify-center gap-2
                   px-6 py-3.5 rounded-xl
                   border border-white/10 bg-white/5
                   text-white font-bold
                   hover:bg-white/10
                   transition w-fit"
          >
            ★ Reviews
          </a>

          <a
            href="/enquiries/export<%= activeStatus === 'All' ? '' : '?status=' + activeStatus %>"
            class="inline-flex items-center justify-center gap-2
                   px-6 py-3.5 rounded-xl
                   bg-gradient-to-r from-emerald-600 to-teal-600
                   text-white font-bold
                   shadow-lg shadow-emerald-900/30
                   hover:from-emerald-500 hover:to-teal-500
                   hover:-translate-y-0.5
                   transition w-fit"
          >
            📊 Export to Excel
          </a>

        </div>

      </div>


      <!-- STATS -->

      <div class="grid
                  grid-cols-2
                  lg:grid-cols-5
                  gap-4 mb-10">

        <%
          const totalCount = allEnquiries.length;
          const countByStatus = { Active: 0, Pending: 0, Deactivate: 0, Complete: 0 };
          allEnquiries.forEach(function(e) {
            const s = e.status || 'Pending';
            if (countByStatus[s] !== undefined) countByStatus[s]++;
          });
        %>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-5">
          <p class="text-xs text-slate-500 uppercase tracking-wider">Total</p>
          <p class="mt-2 text-2xl font-black"><%= totalCount %></p>
        </div>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-5">
          <p class="text-xs text-emerald-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400"></span> Active
          </p>
          <p class="mt-2 text-2xl font-black"><%= countByStatus.Active %></p>
        </div>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-5">
          <p class="text-xs text-amber-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-amber-400"></span> Pending
          </p>
          <p class="mt-2 text-2xl font-black"><%= countByStatus.Pending %></p>
        </div>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-5">
          <p class="text-xs text-slate-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-500"></span> Deactivate
          </p>
          <p class="mt-2 text-2xl font-black"><%= countByStatus.Deactivate %></p>
        </div>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-5">
          <p class="text-xs text-indigo-400 uppercase tracking-wider flex items-center gap-1.5">
            <span class="w-1.5 h-1.5 rounded-full bg-indigo-400"></span> Complete
          </p>
          <p class="mt-2 text-2xl font-black"><%= countByStatus.Complete %></p>
        </div>

      </div>


      <!-- SALES & REVENUE -->

    
       


      <!-- FILTER TABS -->

      <div class="flex flex-wrap items-center gap-2 mb-8">

        <% ['All', 'Active','Deactivate', 'Pending', 'Complete'].forEach(function(s) { %>

          <a href="/enquiries<%= s === 'All' ? '' : '?status=' + s %>"
             class="px-4 py-2 rounded-xl text-sm font-semibold border transition
                    <%= activeStatus === s
                        ? 'bg-white/10 border-white/20 text-white'
                        : 'bg-white/5 text-slate-400 hover:text-white hover:bg-white/10' %>">

            <%= s %>

          </a>

        <% }); %>

      </div>


      <!-- ENQUIRIES SECTION -->

      <div class="flex items-center
                  justify-between mb-5">

        <div>

          <h2 class="text-xl
                     font-bold">
            <%= activeStatus === 'All' ? 'Recent Enquiries' : activeStatus + ' Enquiries' %>
          </h2>

          <p class="text-sm
                    text-slate-500
                    mt-1">
            Newest submissions first.
          </p>

        </div>

      </div>


      <!-- EMPTY STATE -->

      <% if (enquiries.length === 0) { %>

        <div class="bg-slate-900/80
                    border border-white/10
                    rounded-3xl
                    p-16
                    text-center">

          <div class="mx-auto
                      w-20 h-20
                      rounded-2xl
                      bg-indigo-500/10
                      flex items-center
                      justify-center
                      text-4xl mb-6">

            📭

          </div>

          <h3 class="text-2xl
                     font-bold">

            No <%= activeStatus === 'All' ? '' : activeStatus.toLowerCase() + ' ' %>enquiries

          </h3>

          <p class="mt-2
                    text-slate-500
                    max-w-md
                    mx-auto">

            <%= activeStatus === 'All'
                ? "Submissions from your enquiry form will show up here."
                : "No enquiries currently have this status." %>

          </p>

        </div>


      <% } else { %>


        <!-- ENQUIRY GRID -->

        <div class="grid
                    grid-cols-1
                    md:grid-cols-2
                    xl:grid-cols-3
                    gap-6">


          <% enquiries.forEach(function(enquiry) {
               const st = styleFor(enquiry.status);
               const initials = (enquiry.name || '?')
                 .split(' ')
                 .filter(Boolean)
                 .slice(0, 2)
                 .map(function(w) { return w[0].toUpperCase(); })
                 .join('');
          %>


            <article class="group
                            bg-slate-900/80
                            border border-white/10
                            rounded-3xl
                            overflow-hidden
                            hover:border-indigo-500/30
                            transition-all duration-300
                            p-5">


              <!-- TOP: avatar + name + date -->

              <div class="flex items-start
                          justify-between
                          gap-3">

                <div class="flex items-start gap-3 min-w-0">

                  <div class="w-10 h-10 shrink-0 rounded-full
                              bg-gradient-to-br from-indigo-500 to-purple-600
                              flex items-center justify-center
                              text-sm font-bold text-white">
                    <%= initials %>
                  </div>

                  <div class="min-w-0">

                    <h3 class="text-base
                               font-bold
                               truncate
                               max-w-[10rem]">

                      <%= enquiry.name %>

                    </h3>

                    <p class="text-xs
                              text-slate-600
                              mt-0.5">

                      <%= enquiry.createdAt
                          ? new Date(enquiry.createdAt).toLocaleString()
                          : '' %>

                    </p>

                  </div>

                </div>

                <span class="px-3 py-1
                             rounded-full
                             bg-indigo-500/10
                             border border-indigo-400/20
                             text-indigo-300
                             text-xs
                             font-semibold
                             whitespace-nowrap
                             shrink-0">

                  <%= enquiry.package || 'Other' %>

                </span>

              </div>


              <!-- STATUS BADGE -->

              <div class="mt-4">

                <span class="inline-flex items-center gap-1.5
                             px-3 py-1 rounded-full
                             text-xs font-semibold
                             border
                             <%= st.badge %>">
                  <span class="w-1.5 h-1.5 rounded-full <%= st.dot %>"></span>
                  <%= enquiry.status || 'Pending' %>
                </span>

              </div>


              <!-- CONTACT -->

              <div class="mt-4 space-y-1.5">

                <p class="text-sm text-slate-400
                          flex items-center gap-2">
                  📞 <%= enquiry.phone %>
                </p>

                <% if (enquiry.email) { %>
                  <p class="text-sm text-slate-400
                            flex items-center gap-2
                            truncate">
                    ✉️ <%= enquiry.email %>
                  </p>
                <% } %>

              </div>


              <!-- MESSAGE -->

              <% if (enquiry.message) { %>

                <p class="mt-4
                          text-sm
                          text-slate-500
                          bg-white/5
                          border border-white/10
                          rounded-xl
                          p-3
                          line-clamp-3">

                  <%= enquiry.message %>

                </p>

              <% } %>


              <!-- ACTIONS -->

              <div class="border-t
                          border-white/10
                          mt-5 pt-4
                          space-y-3">

                <div class="grid grid-cols-2 gap-3">

                  <a
                    href="tel:<%= enquiry.phone %>"
                    class="flex items-center justify-center gap-1.5
                           py-2.5
                           rounded-xl
                           bg-white/5
                           border border-white/10
                           text-slate-300
                           text-sm
                           font-semibold
                           hover:bg-indigo-600
                           hover:text-white
                           hover:border-indigo-600
                           transition"
                  >
                    📞 Call
                  </a>

                  <a
                    href="https://wa.me/<%= waNumber(enquiry.phone) %>?text=<%= encodeURIComponent(prefillMessage(enquiry)) %>"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="flex items-center justify-center gap-1.5
                           py-2.5
                           rounded-xl
                           bg-white/5
                           border border-white/10
                           text-slate-300
                           text-sm
                           font-semibold
                           hover:bg-emerald-600
                           hover:text-white
                           hover:border-emerald-600
                           transition"
                  >
                    💬 WhatsApp
                  </a>

                  <a
                    href="sms:<%= enquiry.phone %>?body=<%= encodeURIComponent(prefillMessage(enquiry)) %>"
                    class="flex items-center justify-center gap-1.5
                           py-2.5
                           rounded-xl
                           bg-white/5
                           border border-white/10
                           text-slate-300
                           text-sm
                           font-semibold
                           hover:bg-blue-600
                           hover:text-white
                           hover:border-blue-600
                           transition"
                  >
                    💌 SMS
                  </a>

                  <% if (enquiry.email) { %>
                    <a
                      href="mailto:<%= enquiry.email %>"
                      class="flex items-center justify-center gap-1.5
                             py-2.5
                             rounded-xl
                             bg-white/5
                             border border-white/10
                             text-slate-300
                             text-sm
                             font-semibold
                             hover:bg-purple-600
                             hover:text-white
                             hover:border-purple-600
                             transition"
                    >
                      ✉️ Email
                    </a>
                  <% } %>

                </div>

                <!-- STATUS CHANGE -->

                <form action="/enquiries/<%= enquiry.id %>/status" method="POST">

                  <select
                    name="status"
                    onchange="this.form.submit()"
                    class="w-full px-3 py-2.5 rounded-xl
                           bg-slate-950
                           border border-white/10
                           text-sm text-slate-300
                           focus:outline-none
                           focus:border-indigo-500
                           transition"
                  >
                    <% ['Pending', 'Active', 'Complete', 'Deactivate'].forEach(function(s) { %>
                      <option value="<%= s %>" <%= (enquiry.status || 'Pending') === s ? 'selected' : '' %>>
                        Mark as <%= s %>
                      </option>
                    <% }); %>
                  </select>

                </form>

              </div>

            </article>


          <% }); %>

        </div>


      <% } %>


      <!-- FOOTER -->

      <div class="mt-12
                  pt-6
                  border-t
                  border-white/10
                  flex flex-col
                  md:flex-row
                  justify-between
                  gap-3">

        <p class="text-xs
                  text-slate-600">

          Vonexa Admin Panel

        </p>

        <p class="text-xs
                  text-slate-700">

          Stay. Explore. Experience.

        </p>

      </div>


    </main>

  </div>

</body>
</html>
