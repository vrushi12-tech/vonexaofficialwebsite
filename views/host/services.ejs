<%- include('../partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

  <%- include('../partials/host-nav') %>


  <!-- Background -->

  <div class="relative min-h-screen overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute top-0 right-0
                w-96 h-96
                bg-indigo-600/10
                rounded-full
                blur-3xl">
    </div>


    <main class="relative max-w-7xl mx-auto
                 px-6 py-10">


      <!-- HEADER -->

      <div class="flex flex-col
                  lg:flex-row
                  lg:items-center
                  lg:justify-between
                  gap-6 mb-10">

        <div>

          <p class="text-indigo-400
                    text-sm font-semibold
                    uppercase tracking-[0.2em]">
            ADMIN PANEL
          </p>

          <h1 class="mt-2
                     text-3xl md:text-4xl
                     font-black">
            Services
          </h1>

          <p class="mt-2 text-slate-500">
            Manage the packages and services Vonexa offers.
          </p>

        </div>

        <a
          href="/services/add"
          class="inline-flex
                 items-center
                 justify-center
                 gap-2
                 px-6 py-3.5
                 rounded-xl
                 bg-gradient-to-r
                 from-indigo-600
                 to-purple-600
                 font-bold
                 shadow-lg
                 shadow-indigo-900/30
                 hover:from-indigo-500
                 hover:to-purple-500
                 hover:-translate-y-0.5
                 transition w-fit"
        >
          <span class="text-xl">+</span>
          Add Service
        </a>

      </div>


      <!-- STATS -->

      <div class="grid grid-cols-1 md:grid-cols-3 gap-5 mb-10">

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
          <p class="text-sm text-slate-500">Total Services</p>
          <p class="mt-2 text-3xl font-black"><%= services.length %></p>
        </div>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
          <p class="text-sm text-slate-500">One-Time Packages</p>
          <p class="mt-2 text-3xl font-black">
            <%= services.filter(s => s.category === 'One-Time').length %>
          </p>
        </div>

        <div class="bg-slate-900/80 backdrop-blur-xl border border-white/10 rounded-2xl p-6">
          <p class="text-sm text-slate-500">Monthly Plans</p>
          <p class="mt-2 text-3xl font-black">
            <%= services.filter(s => s.category === 'Monthly').length %>
          </p>
        </div>

      </div>


      <!-- EMPTY STATE -->

      <% if (services.length === 0) { %>

        <div class="bg-slate-900/80
                    border border-white/10
                    rounded-3xl
                    p-16
                    text-center">

          <div class="mx-auto
                      w-20 h-20
                      rounded-2xl
                      bg-indigo-500/10
                      flex items-center
                      justify-center
                      text-4xl mb-6">
            🧰
          </div>

          <h3 class="text-2xl font-bold">
            No services yet
          </h3>

          <p class="mt-2 text-slate-500 max-w-md mx-auto">
            Add your first package or service to get started.
          </p>

          <a
            href="/services/add"
            class="inline-flex mt-7 px-6 py-3 rounded-xl
                   bg-gradient-to-r from-indigo-600 to-purple-600
                   font-semibold hover:from-indigo-500 hover:to-purple-500
                   transition"
          >
            + Add First Service
          </a>

        </div>


      <% } else { %>


        <!-- SERVICES GRID -->

        <div class="grid
                    grid-cols-1
                    md:grid-cols-2
                    xl:grid-cols-3
                    gap-6">


          <% services.forEach(function(service) { %>

            <article class="relative
                            bg-slate-900/80
                            border border-white/10
                            rounded-3xl
                            p-6
                            hover:border-indigo-500/30
                            hover:-translate-y-1
                            transition-all duration-300">

              <% if (service.badge) { %>
                <span class="absolute -top-3 left-6
                             px-3 py-1 rounded-full
                             bg-gradient-to-r from-indigo-600 to-purple-600
                             text-xs font-bold whitespace-nowrap">
                  <%= service.badge %>
                </span>
              <% } %>

              <div class="flex items-start justify-between gap-3">

                <div class="w-12 h-12 rounded-2xl
                            bg-indigo-500/10
                            flex items-center justify-center
                            text-2xl">
                  <%= service.icon %>
                </div>

                <span class="px-2.5 py-1 rounded-full text-xs font-semibold
                             bg-white/5 border border-white/10 text-slate-400
                             whitespace-nowrap">
                  <%= service.category %>
                </span>

              </div>

              <p class="text-xs font-bold uppercase tracking-widest text-slate-500 mt-4">Vonexa</p>
              <h3 class="text-xl font-black mt-0.5"><%= service.name %></h3>
              <p class="text-sm text-slate-500 mt-1"><%= service.tagline %></p>

              <div class="mt-5 flex items-baseline gap-2">
                <span class="text-2xl font-black text-white">₹<%= service.price.toLocaleString('en-IN') %></span>
                <span class="text-xs text-slate-500 font-semibold"><%= service.unit %></span>
              </div>

              <ul class="mt-4 space-y-1.5">
                <% service.features.slice(0, 4).forEach(function(f) { %>
                  <li class="flex items-start gap-2 text-xs text-slate-400">
                    <span class="text-indigo-400 mt-0.5">✓</span>
                    <span><%= f %></span>
                  </li>
                <% }); %>
                <% if (service.features.length > 4) { %>
                  <li class="text-xs text-slate-600 pl-5">+ <%= service.features.length - 4 %> more</li>
                <% } %>
              </ul>

              <div class="border-t border-white/10 mt-5 pt-4 flex gap-3">

                <a
                  href="/services/edit/<%= service.id %>"
                  class="flex-1 text-center py-2.5 rounded-xl
                         bg-white/5 border border-white/10
                         text-slate-300 text-sm font-semibold
                         hover:bg-indigo-600 hover:text-white hover:border-indigo-600
                         transition"
                >
                  Edit
                </a>

                <form action="/services/delete/<%= service.id %>" method="POST"
                      class="flex-1"
                      onsubmit="return confirm('Delete this service?');">
                  <button type="submit"
                          class="w-full py-2.5 rounded-xl
                                 bg-red-500/5 border border-red-500/10
                                 text-red-400 text-sm font-semibold
                                 hover:bg-red-500 hover:text-white hover:border-red-500
                                 transition">
                    Delete
                  </button>
                </form>

              </div>

            </article>

          <% }); %>

        </div>


      <% } %>


      <!-- FOOTER -->

      <div class="mt-12
                  pt-6
                  border-t
                  border-white/10
                  flex flex-col
                  md:flex-row
                  justify-between
                  gap-3">

        <p class="text-xs text-slate-600">
          Vonexa Admin Panel
        </p>

        <p class="text-xs text-slate-700">
          Websites. Marketing. Growth.
        </p>

      </div>


    </main>

  </div>

</body>
</html>
