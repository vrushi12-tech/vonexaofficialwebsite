<%- include('../partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">



  <div class="relative overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute -top-32 -right-32
                w-96 h-96
                bg-indigo-600/20
                rounded-full
                blur-3xl">
    </div>


    <main class="relative max-w-2xl mx-auto px-6 py-16">

      <a href="/revenue"
         class="inline-flex items-center gap-2 text-sm text-slate-400
                hover:text-white transition mb-6">
        ← Back to Revenue
      </a>

      <span class="inline-block px-4 py-2 rounded-full
                   bg-emerald-500/10 border border-emerald-400/20
                   text-emerald-300 text-sm font-semibold">
        ✦ NEW SALE
      </span>

      <h1 class="mt-5 text-3xl md:text-4xl font-black">
        Log a Completed Client
      </h1>

      <p class="mt-3 text-slate-400">
        Record the client, the package they took, and what was charged.
      </p>


      <div class="mt-8 bg-slate-900/90 backdrop-blur-xl
                  border border-white/10
                  rounded-3xl p-7 md:p-9
                  shadow-2xl">

        <form action="/revenue/add" method="POST" class="space-y-5">

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Client Name</label>
            <input type="text" name="name" placeholder="Enter client name" required
                   class="w-full px-4 py-3 rounded-xl bg-slate-950
                          border border-white/10 text-white placeholder-slate-600
                          focus:outline-none focus:border-emerald-500
                          focus:ring-2 focus:ring-emerald-500/20 transition">
          </div>


          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Client VNX-ID</label>
            <input type="number" name="VNX-ID" placeholder="Enter client VNX-ID" required
                   class="w-full px-4 py-3 rounded-xl bg-slate-950
                          border border-white/10 text-white placeholder-slate-600
                          focus:outline-none focus:border-emerald-500
                          focus:ring-2 focus:ring-emerald-500/20 transition">
          </div>


          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Phone Number</label>
              <input type="tel" name="phone" placeholder="Phone number" required
                     class="w-full px-4 py-3 rounded-xl bg-slate-950
                            border border-white/10 text-white placeholder-slate-600
                            focus:outline-none focus:border-emerald-500
                            focus:ring-2 focus:ring-emerald-500/20 transition">
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Email</label>
              <input type="email" name="email" placeholder="client@example.com"
                     class="w-full px-4 py-3 rounded-xl bg-slate-950
                            border border-white/10 text-white placeholder-slate-600
                            focus:outline-none focus:border-emerald-500
                            focus:ring-2 focus:ring-emerald-500/20 transition">
            </div>

          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Package Taken</label>
            <select name="package" id="package-select" required
                    class="w-full px-4 py-3 rounded-xl bg-slate-950
                           border border-white/10 text-white
                           focus:outline-none focus:border-emerald-500
                           focus:ring-2 focus:ring-emerald-500/20 transition">
              <option value="" disabled selected>Select a package</option>
              <optgroup label="One-Time Packages">
                <option value="Vonexa Essential" data-price="3499">Vonexa Essential</option>
                <option value="Vonexa Professional" data-price="4999">Vonexa Professional</option>
                <option value="Vonexa Business Plus" data-price="8999">Vonexa Business Plus</option>
              </optgroup>
              <optgroup label="Monthly Plans">
                <option value="Vonexa Social" data-price="3999">Vonexa Social</option>
                <option value="Vonexa Social Plus" data-price="6999">Vonexa Social Plus</option>
                <option value="Vonexa Digital Growth" data-price="14999">Vonexa Digital Growth</option>
              </optgroup>
              <optgroup label="Custom / Other">
                <option value="Landing Page" data-price="2499">Landing Page</option>
                <option value="Business Website" data-price="4999">Business Website</option>
                <option value="NFC Business Card" data-price="299">NFC Business Card</option>
                <option value="QR Menu + Stand" data-price="1299">QR Menu + Stand</option>
                <option value="Google Profile Optimization" data-price="999">Google Profile Optimization</option>
                <option value="Basic Local SEO" data-price="1499">Basic Local SEO</option>
                <option value="Social Media Setup" data-price="999">Social Media Setup</option>
                <option value="Logo Design" data-price="999">Logo Design</option>
                <option value="Custom Web Features" data-price="999">Custom Web Features</option>
                <option value="Business / Reel Video Shooting" data-price="1800">Business / Reel Video Shooting</option>
                <option value="Product Video Shooting" data-price="1800">Product Video Shooting</option>
                <option value="Restaurant / Food Video" data-price="2300">Restaurant / Food Video</option>
                <option value="Promotional Video" data-price="3000">Promotional Video</option>
                <option value="Reel Editing" data-price="499">Reel Editing</option>
                <option value="5 Reels Package" data-price="2499">5 Reels Package</option>
                <option value="10 Reels Package" data-price="4499">10 Reels Package</option>
                <option value="Other" data-price="">Other</option>
              </optgroup>
            </select>
          </div>

          <div class="grid grid-cols-1 sm:grid-cols-2 gap-5">

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Amount Charged (₹)</label>
              <input type="number" name="amount" id="amount-input" min="0" step="1" placeholder="e.g. 4999" required
                     class="w-full px-4 py-3 rounded-xl bg-slate-950
                            border border-white/10 text-white placeholder-slate-600
                            focus:outline-none focus:border-emerald-500
                            focus:ring-2 focus:ring-emerald-500/20 transition">
              <p class="text-xs text-slate-600 mt-1.5">
                Auto-filled from the package's list price — edit if you charged a different amount.
              </p>
            </div>

            <div>
              <label class="block text-sm font-medium text-slate-300 mb-2">Completed On</label>
              <input type="date" name="completedOn"
                     class="w-full px-4 py-3 rounded-xl bg-slate-950
                            border border-white/10 text-white
                            focus:outline-none focus:border-emerald-500
                            focus:ring-2 focus:ring-emerald-500/20 transition">
            </div>

          </div>

          <div>
            <label class="block text-sm font-medium text-slate-300 mb-2">Notes (optional)</label>
            <textarea name="notes" rows="3" placeholder="Any extra details about this sale..."
                      class="w-full px-4 py-3 rounded-xl bg-slate-950
                             border border-white/10 text-white placeholder-slate-600
                             resize-none focus:outline-none focus:border-emerald-500
                             focus:ring-2 focus:ring-emerald-500/20 transition"></textarea>
          </div>

          <button type="submit"
                  class="w-full py-3.5 rounded-xl
                         bg-gradient-to-r from-emerald-600 to-teal-600
                         text-white font-bold shadow-lg shadow-emerald-900/30
                         hover:from-emerald-500 hover:to-teal-500
                         hover:-translate-y-0.5 transition">
            Save Completed Client →
          </button>

        </form>

      </div>

    </main>

  </div>


  <script>
    (function () {
      var select = document.getElementById('package-select');
      var amountInput = document.getElementById('amount-input');

      if (select && amountInput) {
        select.addEventListener('change', function () {
          var selectedOption = select.options[select.selectedIndex];
          var price = selectedOption.getAttribute('data-price');
          if (price) {
            amountInput.value = price;
          }
        });
      }
    })();
  </script>

</body>
</html>
