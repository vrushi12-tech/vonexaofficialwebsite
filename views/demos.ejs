<%- include('./partials/head') %>
</head>

<body class="bg-slate-950 text-white min-h-screen">

  <%- include('./partials/navbar') %>


  <div class="relative overflow-hidden">

    <div class="absolute inset-0
                bg-gradient-to-br
                from-indigo-950
                via-slate-950
                to-purple-950">
    </div>

    <div class="absolute -top-24 -right-24 w-96 h-96 bg-indigo-600/20 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-24 w-96 h-96 bg-purple-600/20 rounded-full blur-3xl"></div>


    <main class="relative max-w-7xl mx-auto px-6 py-16">

      <span class="inline-block px-4 py-2 rounded-full
                   bg-white/10 border border-white/10
                   text-indigo-300 text-sm font-semibold">
        ✦ OUR WORK
      </span>

      <h1 class="mt-6 text-4xl md:text-6xl font-black tracking-tight leading-tight max-w-3xl">
        See what we've
        <span class="text-transparent bg-clip-text
                     bg-gradient-to-r from-indigo-400 to-purple-400">
          built for others.
        </span>
      </h1>

      <p class="mt-5 max-w-2xl text-slate-400 text-lg leading-relaxed">
        A look at real projects and demos from the Vonexa team.
      </p>


      <% if (demos.length === 0) { %>

        <div class="mt-14 bg-slate-900/80 border border-white/10
                    rounded-3xl p-16 text-center">

          <div class="mx-auto w-20 h-20 rounded-2xl
                      bg-indigo-500/10
                      flex items-center justify-center
                      text-4xl mb-6">
            🖼️
          </div>

          <h3 class="text-2xl font-bold">Nothing here yet</h3>
          <p class="mt-2 text-slate-500 max-w-md mx-auto">
            Sample work will show up here soon.
          </p>

        </div>

      <% } else { %>

        <div class="mt-14 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-7">

          <% demos.forEach(function(demo) { %>

            <div class="demo-card group bg-slate-900 border border-white/10
                        rounded-3xl overflow-hidden
                        shadow-xl shadow-black/20
                        hover:-translate-y-2
                        hover:border-indigo-500/40
                        transition-all duration-300">

              <% if (demo.imageUrl || demo.videoUrl) { %>
                <div class="relative overflow-hidden h-52 bg-slate-950">

                  <% if (demo.imageUrl) { %>
                    <img
                      src="<%= demo.imageUrl %>"
                      alt="<%= demo.title %>"
                      class="w-full h-full object-cover
                             group-hover:scale-105
                             transition-transform duration-500"
                    >
                  <% } %>

                  <% if (demo.videoUrl) { %>
                    <video
                      class="demo-video absolute inset-0 w-full h-full object-cover
                             opacity-0 transition-opacity duration-300"
                      src="<%= demo.videoUrl %>"
                      muted
                      loop
                      playsinline
                      preload="none"
                    ></video>

                    <span class="absolute top-3 right-3
                                 bg-black/60 backdrop-blur-md
                                 border border-white/10
                                 px-2.5 py-1 rounded-full
                                 text-xs font-semibold
                                 flex items-center gap-1
                                 pointer-events-none">
                      🎬 Hover to play
                    </span>
                  <% } %>

                  <div class="absolute inset-0
                              bg-gradient-to-t
                              from-black/60
                              via-transparent
                              to-transparent
                              pointer-events-none">
                  </div>
                </div>
              <% } %>

              <div class="p-6">

                <h2 class="text-xl font-bold text-white
                           group-hover:text-indigo-400 transition">
                  <%= demo.title %>
                </h2>

                <% if (demo.description) { %>
                  <p class="text-sm text-slate-500 mt-2 leading-relaxed">
                    <%= demo.description %>
                  </p>
                <% } %>

                <% if (demo.link) { %>
                  <a href="<%= demo.link %>"
                     target="_blank"
                     rel="noopener noreferrer"
                     class="inline-flex items-center gap-2 mt-5
                            text-indigo-400 font-semibold text-sm
                            hover:text-indigo-300 transition">
                    View Live →
                  </a>
                <% } %>

              </div>

            </div>

          <% }); %>

        </div>

      <% } %>

    </main>

  </div>


  <!-- Footer -->

  <footer class="border-t border-white/10">

    <div class="max-w-7xl mx-auto px-6 py-8
                flex flex-col md:flex-row
                justify-between items-center gap-3">

      <p class="text-slate-500 text-sm">
        © <%= new Date().getFullYear() %> Vonexa Digital Solutions
      </p>

      <p class="text-slate-600 text-sm">
        Websites. Marketing. Growth.
      </p>

    </div>

  </footer>


  <script>
    (function () {
      document.querySelectorAll('.demo-card').forEach(function (card) {
        var video = card.querySelector('.demo-video');
        if (!video) return;

        card.addEventListener('mouseenter', function () {
          video.currentTime = 0;
          var playPromise = video.play();
          if (playPromise && playPromise.catch) {
            playPromise.catch(function () {
              // Autoplay can be blocked in some browsers; ignore silently.
            });
          }
          video.classList.remove('opacity-0');
          video.classList.add('opacity-100');
        });

        card.addEventListener('mouseleave', function () {
          video.pause();
          video.currentTime = 0;
          video.classList.remove('opacity-100');
          video.classList.add('opacity-0');
        });

        // Basic touch support: tap to toggle play/pause instead of hover.
        card.addEventListener('touchstart', function () {
          if (video.paused) {
            video.play().catch(function () {});
            video.classList.remove('opacity-0');
            video.classList.add('opacity-100');
          } else {
            video.pause();
            video.classList.remove('opacity-100');
            video.classList.add('opacity-0');
          }
        }, { passive: true });
      });
    })();
  </script>

</body>
</html>
